{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "sh -c 'root=$(git rev-parse --show-toplevel) && exec \"$root/scripts/setup.sh\" --session'",
            "timeout": 600
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "sh -c 'root=$(git rev-parse --show-toplevel) && exec \"$root/scripts/hooks/agent-pretooluse.sh\"'",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
