# Supabase Postgres via the pooler, transaction mode (port 6543); the client sets prepare: false.
# For `bun run db:migrate`, use the session pooler (port 5432) or the direct connection if DDL fails on 6543.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
# Publishable (anon) key: safe in the browser, used for Auth only.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Secret: server only, used for Realtime broadcasts. Never expose with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
# Public origin for OAuth redirects, e.g. https://compa.vercel.app (falls back to the request origin).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# "mock" serves the OpenAPI examples on every route, with no auth and no database.
API_MODE=
OPENAI_API_KEY=
OPENAI_STT_MODEL=gpt-4o-mini-transcribe
OPENAI_TEXT_MODEL=gpt-5.4-mini
# db:seed only: SEED_DEMO=1 creates the running event founders-fest; SEED_ADMIN_HANDLE=<handle> makes that user an admin.
SEED_DEMO=
SEED_ADMIN_HANDLE=
# db:seed only: SEED_TEST_EVENT=1 creates the test event codex-conf-2026 with 13 test users (docs/testing/real-mode.md).
SEED_TEST_EVENT=
# Real-mode test harness: header x-compa-automation for test runners. At least 32 characters; unset disables it.
# Never commit or log the value. Server only.
TEST_AUTOMATION_SECRET=
# Playwright e2e (docs/flows/README.md "E2E tests"): target URL; unset starts `bun run dev` on localhost:3000.
# https://compa.lol runs only read-only @prod specs. Real-mode specs also need TEST_AUTOMATION_SECRET of the target.
E2E_BASE_URL=
