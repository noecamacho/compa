  "views": {
    "public.event_scores": {
      "columns": {
        "event_id": {
          "name": "event_id",
          "type": "uuid",
          "primaryKey": false,
          "notNull": true
        },
        "user_id": {
          "name": "user_id",
          "type": "uuid",
          "primaryKey": false,
          "notNull": true
        },
        "points": {
          "name": "points",
          "type": "integer",
          "primaryKey": false,
          "notNull": true
        },
        "connections": {
          "name": "connections",
          "type": "integer",
          "primaryKey": false,
          "notNull": true
        }
      },
      "definition": "\n  with awards as (\n    select c.event_id, p.user_id, c.points, 1 as is_connection\n    from connections c cross join lateral (values (c.requester_id), (c.addressee_id)) as p (user_id)\n    where c.status = 'accepted'\n    union all\n    select c.event_id, p.user_id, i.points, 0\n    from interactions i join connections c on c.id = i.connection_id\n    cross join lateral (values (c.requester_id), (c.addressee_id)) as p (user_id)\n    where i.approved_at is not null\n  )\n  select event_id, user_id, sum(points)::int as points, sum(is_connection)::int as connections\n  from awards group by event_id, user_id",
      "name": "event_scores",
      "schema": "public",
      "isExisting": false,
      "with": {
        "securityInvoker": true
      },
      "materialized": false
    },
    "public.lifetime_scores": {
      "columns": {
        "user_id": {
