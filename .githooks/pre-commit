#!/bin/sh
# Keeps raw/ immutable and keeps local-only or generated files out of the repository.
set -u

FORBIDDEN_RE='^(\.claude/settings\.local\.json|\.serena/project\.local\.yml|\.serena/cache/|repomix-output\.)|(^|/)\.env(\.[^/]+)?$'
ALLOWED_RE='(^|/)\.env\.example$'

fail() {
  printf 'pre-commit rejected: %s\n' "$1" >&2
  exit 1
}

changed_raw=$(git diff --cached --name-only --diff-filter=MDR -- raw/ | grep -v '^raw/README\.md$' || true)
[ -z "$changed_raw" ] || fail "raw/ is immutable; do not modify, rename or delete: $changed_raw"

forbidden=$(git diff --cached --name-only --diff-filter=ACMR | grep -E "$FORBIDDEN_RE" | grep -Ev "$ALLOWED_RE" || true)
[ -z "$forbidden" ] || fail "local-only or generated files must not be committed: $forbidden"
exit 0
